+    admission = _admit(entries, 1, ["A"], reset=PR_COMMENT)
+    assert admission.count == 2 and admission.to_run == ["A"]
+    with pytest.raises(launcher.ReviewRefusedError, match="round 1"):
+        _admit(entries, 2, ["A"], reset=PR_COMMENT)
