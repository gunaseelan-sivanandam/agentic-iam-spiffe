@startuml
!pragma layout smetana
left to right direction
title Agentic IAM with SPIFFE/SPIRE - Network Architecture (M4 + M4a/M4b)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam package {
  BorderColor #a5afbf
  BackgroundColor #ffffff
}
skinparam component {
  BorderColor #41516a
  BackgroundColor #ffffff
}

package "SPIRE control plane" {
  [spire-token-init] as token_init
  [spire-server] as spire_server
  [spire-agent] as spire_agent
}

package "capiss_edge_net" #edf6ff {
  [agent-a] as capiss_agent
  [rogue] as capiss_rogue
  [capability-issuer-envoy] as capiss_envoy
}
package "capiss_app_net" #edf8ef {
  [capability-issuer] as capiss_app
}
package "capiss internal dependencies" {
  [OPA] as opa
  [Redis] as redis_capiss
}

package "toolb_edge_net" #edf6ff {
  [agent-a] as toolb_agent
  [rogue] as toolb_rogue
  [tool-b-envoy] as toolb_envoy
}
package "toolb_app_net" #edf8ef {
  [tool-b] as toolb_app
}
package "tool-b shared state" {
  [Redis] as redis_toolb
}

package "jiratool_edge_net (M4a/M4b)" #fff9ec {
  [agent-a] as jira_agent
  [rogue] as jira_rogue
  [jira-tool-envoy\nhost:10443] as jira_envoy
}
package "jiratool_app_net (M4a/M4b)" #fff9ec {
  [jira-tool] as jira_tool
  [Redis] as redis_jira
}
package "Jira upstream side, not edge" #f4f4f4 {
  [jira-mock] as jira_mock
  [Jira Cloud\noptional live smoke] as jira_cloud
}

token_init --> spire_server
spire_agent --> spire_server : node attestation

capiss_agent --> capiss_envoy : mTLS
capiss_rogue --> capiss_envoy : mTLS negative proof
capiss_envoy --> capiss_app : internal HTTP + trusted identity
capiss_app --> opa : policy query
capiss_app --> redis_capiss : budget, registry, mint marker

toolb_agent --> toolb_envoy : mTLS
toolb_rogue --> toolb_envoy : mTLS negative proof
toolb_envoy --> toolb_app : internal HTTP + trusted identity
toolb_app --> redis_toolb : spend/rate + discovery writes

jira_agent -[#b98922,dashed]-> jira_envoy : mTLS issue read / description write
jira_rogue -[#b98922,dashed]-> jira_envoy : mTLS negative proof
jira_envoy -[#b98922,dashed]-> jira_tool : internal HTTP + trusted identity
jira_tool -[#b98922,dashed]-> redis_jira : budget/rate
jira_tool -[#b98922,dashed]-> jira_mock : authorized upstream only
jira_tool -[#b98922,dashed]-> jira_cloud : optional live mode

note bottom of jira_envoy
  Edge clients do not route directly to jira-tool or jira-mock.
end note
note bottom of jira_tool
  Project mismatch and read-token writes deny before upstream use.
end note
note bottom of jira_mock
  Mock has IAM and NAS data but is upstream-only and not host-exposed.
end note

legend bottom
  Jira networks and arrows show the implemented M4a/M4b runtime path.
endlegend
@enduml
