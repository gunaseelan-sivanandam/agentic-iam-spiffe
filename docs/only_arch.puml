@startuml
title Agentic IAM with SPIFFE/SPIRE — Component Architecture (M4)

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam LegendBackgroundColor white
skinparam LegendBorderColor black

package "Control Plane" {
  [spire-server]
  [spire-token-init]
  [spire-agent]
}

package "Capability Issuer" {
  [capability-issuer]
  [capability-issuer-envoy]
  [opa]
}

package "Enforcement State" {
  [redis]
}

package "Tool-B" {
  [tool-b]
  [tool-b-envoy]
}

package "Clients" {
  [agent-a]
  [rogue]
}

' Control plane interactions
[spire-token-init] --> [spire-server]
[spire-agent] --> [spire-server] : SPIFFE mTLS

' Data plane
[agent-a] -[#green]-> [capability-issuer-envoy] : root/resource mint
[rogue] -[#green]-> [capability-issuer-envoy] : root/resource mint
[capability-issuer-envoy] --> [capability-issuer] : Trusted identity header
[capability-issuer] --> [opa] : Policy decision
[capability-issuer] -[#brown]-> [redis] : root budget init + registry read + mint marker

[agent-a] -[#orange]-> [tool-b-envoy] : capability-enforced request
[rogue] -[#orange]-> [tool-b-envoy] : capability-enforced request
[tool-b-envoy] --> [tool-b] : Trusted identity header
[tool-b] -[#brown]-> [redis] : budget/rate + discovery writes

' Offline delegation (not in capiss hot path)
[agent-a] -[#purple,dashed]-> [rogue] : offline delegated token handoff

' SPIFFE Workload API
[spire-agent] -[#blue,dashed]-> [capability-issuer-envoy]
[spire-agent] -[#blue,dashed]-> [tool-b-envoy]
[spire-agent] -[#blue,dashed]-> [agent-a]
[spire-agent] -[#blue,dashed]-> [rogue]

legend right
  |= Line |= Meaning |
  | <color:blue><line:blue,dashed>────</line></color> | Workload API |
  | <color:green><line:green>────</line></color> | Mint request |
  | <color:orange><line:orange>────</line></color> | Protected tool request |
  | <color:brown><line:brown>────</line></color> | Trusted state access (Redis) |
  | <color:purple><line:purple,dashed>────</line></color> | Offline delegation handoff |
endlegend

@enduml
