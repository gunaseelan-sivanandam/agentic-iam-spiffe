@startuml
!pragma layout smetana
left to right direction
title Agentic IAM with SPIFFE/SPIRE - Component Architecture (M4 + M4a/M4b)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam ArrowColor #33445c
skinparam defaultFontName Arial
skinparam package {
  BorderColor #a5afbf
  BackgroundColor #ffffff
}
skinparam component {
  BorderColor #41516a
  BackgroundColor #ffffff
}

package "SPIRE control plane" {
  [spire-token-init] as token_init
  [spire-server] as spire_server
  [spire-agent] as spire_agent
}

package "Capability issuance path" {
  [agent-a / rogue] as capiss_clients
  [capability-issuer-envoy] as capiss_envoy
  [capability-issuer] as capiss_app
  [OPA] as opa
  [Redis] as redis_capiss
}

package "Current protected resource path: tool-b" {
  [agent-a / rogue] as toolb_clients
  [tool-b-envoy] as toolb_envoy
  [tool-b] as toolb_app
  [Redis] as redis_toolb
}

package "M4a/M4b Jira connector" #fff9ec {
  [agent-a / rogue] as jira_clients
  [jira-tool-envoy] as jira_envoy
  [jira-tool] as jira_tool
  [Redis] as redis_jira
  [jira-mock] as jira_mock
  [Jira Cloud\noptional live smoke] as jira_cloud
}

token_init --> spire_server
spire_agent --> spire_server : node attestation

capiss_clients --> capiss_envoy : mTLS mint request
capiss_envoy --> capiss_app : trusted identity header
capiss_app --> opa : policy decision
capiss_app --> redis_capiss : root budget, registry, mint marker
note right of opa
  M4a/M4b policy:
  agent-a may mint read/write only
  for jira-tool:/project:IAM
end note

toolb_clients --> toolb_envoy : mTLS tool request
toolb_envoy --> toolb_app : trusted identity header
toolb_app --> redis_toolb : budget/rate and discovery writes

jira_clients -[#b98922,dashed]-> jira_envoy : mTLS issue read / description write
jira_envoy -[#b98922,dashed]-> jira_tool : trusted identity header
jira_tool -[#b98922,dashed]-> redis_jira : budget/rate
jira_tool -[#b98922,dashed]-> jira_mock : authorized upstream only
jira_tool -[#b98922,dashed]-> jira_cloud : optional live mode
note right of jira_tool
  M4a/M4b:
  GET IAM-1 allowed
  PUT IAM description requires write
  GET NAS-1 denied before upstream
end note

spire_agent -[#2f66b3,dashed]-> capiss_envoy : Workload API
spire_agent -[#2f66b3,dashed]-> toolb_envoy : Workload API
spire_agent -[#2f66b3,dashed]-> jira_envoy : Workload API target

legend bottom
  Jira connector lines show the implemented M4a/M4b runtime path.
endlegend
@enduml
